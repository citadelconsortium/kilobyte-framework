{
  "base_model": "ibm-granite/granite-4.1-3b",
  "_base_model_note": "New 3B Apache-2.0 base selected for Kilo: native function calling, strong instruction following and code capability, while Q4_K_M remains viable on the 4 GB CPU-only VM.",
  "max_seq_len": 4096,
  "lora": {
    "r": 16,
    "alpha": 16,
    "dropout": 0.0,
    "target_modules": [
      "q_proj",
      "k_proj",
      "v_proj",
      "o_proj",
      "gate_proj",
      "up_proj",
      "down_proj"
    ]
  },
  "train": {
    "epochs": 1,
    "learning_rate": 0.00005,
    "warmup_ratio": 0.03,
    "weight_decay": 0.01,
    "lr_scheduler": "cosine",
    "per_device_batch_size": 2,
    "grad_accum": 8,
    "load_in_4bit": true,
    "bf16": true,
    "gradient_checkpointing": true,
    "packing": true,
    "optim": "adamw_8bit",
    "seed": 3407,
    "save_steps": 200,
    "eval_ratio": 0.05
  },
  "quantisation": "Q4_K_M",
  "output_name": "kilobyte-4.1-3b-q4_k_m.gguf",
  "kaggle": {
    "username": "PASTE_KAGGLE_USERNAME",
    "dataset_slug": "kilobyte-sft",
    "notebook_slug": "kilobyte-train",
    "enable_gpu": true,
    "accelerator": "NvidiaTeslaT4",
    "enable_internet": true,
    "model_sources": []
  }
}
